{
  "name": "dsh-jailbreak-manager",
  "version": "0.1.2",
  "description": "DSH Desktop 破限词管理器：按模型自动/手动注入对应 jailbreak prompt，词库为可编辑 md 文件",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "jailbreaks",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "xiagaogaozi",
  "homepage": "https://github.com/xiagaogaozi/dsh-jailbreak-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiagaogaozi/dsh-jailbreak-manager.git"
  },
  "bugs": {
    "url": "https://github.com/xiagaogaozi/dsh-jailbreak-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "jailbreak",
    "novel",
    "prompt"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "category": "extension",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dshClient": {
    "inject": [
      "@deepseek-ai/dsh-client-locale",
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-client-ui-conversation"
    ],
    "platform": "web"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "^19.2.4",
    "lightningcss": "^1.33.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
